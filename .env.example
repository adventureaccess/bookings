# Names only. Never put a real value in this file.
# Local: copy to .env.local and fill in. Netlify: add in the site's
# environment variables, never commit.
#
# Every name is read on the server only. Astro sends names with its public
# prefix to the browser; this app has none, and CI fails if one appears.

# Supabase (dev project). Required now.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bypasses row-level security. Required. Mark as secret in Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# Where the website publishes trips.json. Optional until that feed exists.
TRIPS_FEED_URL=

# Local development only: act as this staff member without Google sign-in.
# Ignored by every build; the email must still be in the staff table.
DEV_STAFF_EMAIL=

# Public base URL, e.g. https://book.adventure-access.com. Optional:
# falls back to the URL Netlify gives the deploy, then http://localhost:4321.
SITE_URL=

# Reserved. Booking access tokens are random and stored hashed, so nothing
# is signed yet.
TOKEN_SIGNING_SECRET=

# Stripe, test mode only (sk_test_...). The webhook secret (whsec_...) comes
# from `stripe listen` locally, or from the webhook endpoint in the Stripe
# dashboard for a deployed site.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Leave unset. A live Stripe key is refused unless this is true.
STRIPE_LIVE_MODE=

# Shared secret header for cron and internal routes. Any long random string.
CRON_SECRET=

# Traveler documents go to a restricted Google Shared Drive.
# The key is the service account's JSON key file, pasted whole or
# base64-encoded. The folder ID is the Shared Drive's ID, or a folder in it.
# Without these, uploads are off (the dev server uses a local folder).
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# HubSpot private app token and Resend. Milestone 7.
HUBSPOT_ACCESS_TOKEN=
RESEND_API_KEY=

# Who emails come from, like: Adventure Access <bookings@mail.adventure-access.com>
# The domain must be verified in Resend. Emails stay queued until this is set.
EMAIL_FROM=

# Where staff notices go. Leave blank for info@adventure-access.com.
STAFF_NOTIFY_EMAIL=

# Cloudflare Turnstile. Milestone 6.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
