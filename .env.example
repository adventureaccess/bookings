# Names only. Never put a real value in this file.
# Local: copy to .env.local and fill in. Netlify: add in the site's
# environment variables, never commit.
#
# Every name is read on the server only. Astro sends names with its public
# prefix to the browser; this app has none, and CI fails if one appears.

# Supabase (dev project). Required now.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Bypasses row-level security. Required. Mark as secret in Netlify.
SUPABASE_SERVICE_ROLE_KEY=

# Where the website publishes trips.json. Optional until that feed exists.
TRIPS_FEED_URL=

# Local development only: act as this staff member without Google sign-in.
# Ignored by every build; the email must still be in the staff table.
DEV_STAFF_EMAIL=

# Public base URL, e.g. https://book.adventure-access.com. Optional:
# falls back to the URL Netlify gives the deploy, then http://localhost:4321.
SITE_URL=

# Signs booking page access tokens. Milestone 3.
TOKEN_SIGNING_SECRET=

# Stripe, test mode only. Milestone 4.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret header for cron and internal routes. Milestone 4.
CRON_SECRET=

# HubSpot private app token and Resend. Milestone 5.
HUBSPOT_ACCESS_TOKEN=
RESEND_API_KEY=

# Cloudflare Turnstile. Milestone 6.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
