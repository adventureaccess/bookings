# Names only. Never put a real value in this file.
# Local: copy to .env.local and fill in. Netlify: add in the site's environment variables, never commit.
# Only NEXT_PUBLIC_ names reach the browser. Nothing secret may use that prefix.

# Supabase (dev project). Required now.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, e.g. https://book.adventure-access.com. Optional:
# falls back to the URL Netlify gives the deploy, then http://localhost:3000.
SITE_URL=

# Signs booking page access tokens. Milestone 3.
TOKEN_SIGNING_SECRET=

# Stripe, test mode only. Milestone 4.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret header for cron and internal routes. Milestone 4.
CRON_SECRET=

# HubSpot private app token and Resend. Milestone 5.
HUBSPOT_ACCESS_TOKEN=
RESEND_API_KEY=

# Cloudflare Turnstile. Milestone 6.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
