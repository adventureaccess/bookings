---
import { actions } from "astro:actions";
import Notice from "../../components/Notice.astro";
import Admin from "../../layouts/Admin.astro";
import { formatDate } from "../../lib/dates";
import { listWaivers } from "../../lib/documents/db";
import { MAX_UPLOAD_BYTES } from "../../lib/documents/files";

// Waiver versions: the PDF travelers read and sign. Only an admin can add or
// publish one, because publishing can never be undone.
const results = [
  { result: Astro.getActionResult(actions.uploadWaiver), done: "uploaded" },
  { result: Astro.getActionResult(actions.publishWaiver), done: "published" },
  { result: Astro.getActionResult(actions.deleteWaiverDraft), done: "deleted" },
];
for (const { result, done } of results) {
  if (result?.data?.ok) return Astro.redirect(`/admin/waivers?done=${done}`);
}
const problem = results
  .map(({ result }) => result?.error?.message ?? (result?.data && !result.data.ok ? result.data.message : null))
  .find((message) => message);

const waivers = await listWaivers();
const isAdmin = Astro.locals.staff?.role === "admin";
const FLASH: Record<string, string> = {
  uploaded: "Draft saved. Open the PDF to check it, then publish.",
  published: "Waiver published. It can no longer be changed.",
  deleted: "Draft deleted.",
};
const flash = Astro.url.searchParams.get("done");
const megabytes = Math.floor(MAX_UPLOAD_BYTES / (1024 * 1024));
const kilobytes = (bytes: number) => `${Math.max(1, Math.round(bytes / 1024)).toLocaleString("en-US")} KB`;
const input = "w-full border border-warm-light bg-white px-3 py-2 font-light text-charcoal";
---

<Admin title="Waivers">
  {flash && FLASH[flash] && <Notice kind="success">{FLASH[flash]}</Notice>}
  {problem && <Notice kind="error">{problem}</Notice>}

  <p class="max-w-2xl text-sm text-warm-mid">
    The waiver is a PDF each traveler reads and signs on their booking page by typing their full
    name. Once a version is published it is locked for good, so there is always a record of the
    exact form each person signed. To change the waiver, upload a new version and attach it to
    the departures that should use it.
  </p>

  <div class="mt-8 overflow-x-auto">
    <table class="w-full min-w-[40rem] text-left text-sm">
      <thead class="border-b border-warm-light text-xs uppercase tracking-wider text-warm-mid">
        <tr>
          <th scope="col" class="py-2 pr-4 font-medium">Version</th>
          <th scope="col" class="py-2 pr-4 font-medium">Title</th>
          <th scope="col" class="py-2 pr-4 font-medium">File</th>
          <th scope="col" class="py-2 font-medium">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-cream-dark">
        {
          waivers.map((waiver) => (
            <tr data-waiver={waiver.version}>
              <td class="py-3 pr-4">{waiver.version}</td>
              <td class="py-3 pr-4 text-dark">{waiver.title}</td>
              <td class="py-3 pr-4">
                {waiver.published_at ? (
                  <a class="underline decoration-orange underline-offset-4" href={`/waiver/${waiver.id}`} target="_blank" rel="noopener">
                    {waiver.file_name}
                  </a>
                ) : (
                  waiver.file_name
                )}
                <span class="block text-xs text-warm-mid">{kilobytes(waiver.byte_size)}</span>
              </td>
              <td class="py-3">
                {waiver.published_at ? (
                  `Published ${formatDate(waiver.published_at.slice(0, 10))}. Locked.`
                ) : (
                  <>
                    Draft. Travelers cannot see it.
                    {isAdmin && (
                      <div class="mt-2 flex flex-wrap gap-2">
                        <details>
                          <summary class="cursor-pointer text-xs underline underline-offset-4">Publish</summary>
                          <form method="POST" action={actions.publishWaiver} class="mt-2">
                            <input type="hidden" name="id" value={waiver.id} />
                            <p class="mb-2 max-w-xs text-xs text-warm-mid">
                              Publishing locks this file permanently. Make sure it is the final,
                              approved form.
                            </p>
                            <button type="submit" class="cursor-pointer border border-orange px-4 py-1.5 text-xs font-medium uppercase tracking-[0.15em] text-orange hover:bg-orange hover:text-white">
                              Publish version {waiver.version}
                            </button>
                          </form>
                        </details>
                        <form method="POST" action={actions.deleteWaiverDraft}>
                          <input type="hidden" name="id" value={waiver.id} />
                          <button type="submit" class="cursor-pointer text-xs underline underline-offset-4">
                            Delete draft
                          </button>
                        </form>
                      </div>
                    )}
                  </>
                )}
              </td>
            </tr>
          ))
        }
        {
          waivers.length === 0 && (
            <tr>
              <td colspan="4" class="py-6 text-warm-mid">No waiver yet.</td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>

  {
    isAdmin ? (
      <section class="mt-12 max-w-xl border-t border-cream-dark pt-8">
        <h2 class="text-2xl">Upload a new version</h2>
        <form method="POST" action={actions.uploadWaiver} enctype="multipart/form-data" class="mt-4 space-y-4">
          <label class="block text-sm font-medium text-dark">
            Title
            <input type="text" name="title" maxlength="200" value="Travel Consent and Release of Liability" required class={`${input} mt-1`} />
          </label>
          <label class="block text-sm font-medium text-dark">
            PDF file
            <input type="file" name="file" accept="application/pdf" required class={`${input} mt-1`} />
          </label>
          <p class="text-xs text-warm-mid">
            A PDF of up to {megabytes} MB. It is saved as a draft; nothing changes for travelers
            until you publish it and attach it to a departure.
          </p>
          <button type="submit" class="cursor-pointer bg-dark px-6 py-2 text-sm font-medium uppercase tracking-[0.15em] text-white transition-colors hover:bg-orange">
            Save as draft
          </button>
        </form>
      </section>
    ) : (
      <p class="mt-8 text-sm text-warm-mid">Only an admin can upload or publish a waiver.</p>
    )
  }
</Admin>
