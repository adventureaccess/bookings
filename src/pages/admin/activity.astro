---
import Admin from "../../layouts/Admin.astro";
import { actionLabel, activityDetails, activityLink, listActivity } from "../../lib/admin/reports";

// Who did what, newest first. Staff only, like everything under /admin.
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const requested = Astro.url.searchParams.get("record");
const entityId = requested && UUID.test(requested) ? requested : null;
const entries = await listActivity({ entityId, limit: 300 });

const when = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  hour: "numeric",
  minute: "2-digit",
  timeZone: "America/New_York",
  timeZoneName: "short",
});
const ENTITY_LABEL: Record<string, string> = {
  booking: "Booking",
  bookings: "All bookings",
  departure: "Departure",
  policy: "Policy",
  waiver: "Waiver",
  trips: "Tours",
  settings: "Settings",
  sync_job: "Sync job",
};
---

<Admin title="Activity">
  <p class="-mt-4 mb-8 max-w-prose text-sm text-warm-mid">
    Every change staff make is recorded here with who made it: departures, policies, payments,
    credits, document reviews, exports. Entries are never edited or removed.
    {
      entityId && (
        <>
          {" "}Showing one record only.{" "}
          <a class="underline underline-offset-4" href="/admin/activity">Show everything</a>
        </>
      )
    }
  </p>

  <div class="overflow-x-auto">
    <table class="w-full min-w-[52rem] text-left text-sm">
      <thead class="border-b border-warm-light text-xs uppercase tracking-wider text-warm-mid">
        <tr>
          <th scope="col" class="py-2 pr-4 font-medium">When</th>
          <th scope="col" class="py-2 pr-4 font-medium">Who</th>
          <th scope="col" class="py-2 pr-4 font-medium">What</th>
          <th scope="col" class="py-2 pr-4 font-medium">On</th>
          <th scope="col" class="py-2 font-medium">Details</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-cream-dark">
        {
          entries.map((entry) => {
            const link = activityLink(entry);
            return (
              <tr data-action={entry.action}>
                <td class="py-3 pr-4 whitespace-nowrap">{when.format(new Date(entry.created_at))}</td>
                <td class="py-3 pr-4">{entry.actor}</td>
                <td class="py-3 pr-4 text-dark">{actionLabel(entry.action)}</td>
                <td class="py-3 pr-4">
                  {link ? (
                    <a class="underline decoration-orange underline-offset-4" href={link}>
                      {ENTITY_LABEL[entry.entity] ?? entry.entity}
                    </a>
                  ) : (
                    (ENTITY_LABEL[entry.entity] ?? entry.entity)
                  )}
                </td>
                <td class="py-3 text-warm-mid">{activityDetails(entry.data)}</td>
              </tr>
            );
          })
        }
        {
          entries.length === 0 && (
            <tr>
              <td colspan="5" class="py-6 text-warm-mid">Nothing recorded yet.</td>
            </tr>
          )
        }
      </tbody>
    </table>
  </div>
  {entries.length === 300 && <p class="mt-4 text-xs text-warm-mid">Showing the newest 300 entries.</p>}
</Admin>
