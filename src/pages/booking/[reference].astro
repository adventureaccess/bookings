---
import { actions } from "astro:actions";
import Notice from "../../components/Notice.astro";
import Public from "../../layouts/Public.astro";
import { getBookingSummary } from "../../lib/bookings/db";
import { hashAccessToken, isAccessToken } from "../../lib/bookings/token";
import { formatDate, formatDateRange } from "../../lib/dates";
import { formatUsd } from "../../lib/money";
import { balanceCents, cardFeeCents, formatFeePercent, payOptions } from "../../lib/payments/due";
import { bookingReference } from "../../lib/schemas";

// A traveler's own booking: /booking/<reference>?t=<access token>. Both are
// needed. A wrong or missing token looks exactly like a booking that does
// not exist.
Astro.response.headers.set("Cache-Control", "no-store");

const reference = Astro.params.reference ?? "";
const token = Astro.url.searchParams.get("t") ?? "";
if (!bookingReference.safeParse(reference).success || !isAccessToken(token)) {
  return Astro.rewrite("/404");
}

const started = Astro.getActionResult(actions.startPayment);
if (started?.data?.ok) return Astro.redirect(started.data.url);

const booking = await getBookingSummary(reference, hashAccessToken(token));
if (!booking) return Astro.rewrite("/404");

const isPending = booking.status === "pending";
const isClosed = booking.status === "canceled" || booking.status === "refunded";
const held = isPending && booking.hold_active;
const minutesLeft = booking.hold_expires_at
  ? Math.max(1, Math.ceil((Date.parse(booking.hold_expires_at) - Date.now()) / 60_000))
  : 0;
const seats = booking.traveler_count === 1 ? "seat" : "seats";

const balance = balanceCents(booking);
const options = isClosed || !booking.departure_open ? [] : payOptions(booking);
const feeBps = booking.card_fee_bps;
const returned = Astro.url.searchParams.get("pay");
const payError = started?.error?.message ?? (started?.data && !started.data.ok ? started.data.message : null);

// Posting keeps the token in the address so the page can be shown again.
const postUrl = `${Astro.url.pathname}?${new URLSearchParams({ _action: "startPayment", t: token })}`;
// A private departure's key is not kept with the booking, so only public
// departures get a link back to the form.
const formPath = booking.is_private
  ? null
  : `/${booking.trip_slug}/${booking.departure_id}?travelers=${booking.traveler_count}`;

const heading = isClosed
  ? "This booking is canceled."
  : booking.status === "paid_in_full"
    ? "You are paid in full."
    : booking.status === "deposit_paid"
      ? "Your place is confirmed."
      : held
        ? `Your ${seats} ${booking.traveler_count === 1 ? "is" : "are"} held.`
        : "Your place is not confirmed yet.";

const METHOD = {
  card: "Card",
  wire: "Wire",
  ach: "ACH",
  check: "Check",
  cash: "Cash",
  other: "Other",
} as const;
---

<Public title={`Booking ${booking.reference}`}>
  <p class="text-xs font-medium uppercase tracking-[0.3em] text-orange">
    Booking {booking.reference}
  </p>
  <h1 class="mt-3 text-5xl font-light" data-testid="booking-heading">{heading}</h1>

  <div class="mt-8 max-w-2xl space-y-8">
    {
      returned === "paid" && (
        <Notice kind="success">
          Thank you. Your card payment went through. It shows below once it is recorded, usually
          within a minute. Reload this page if it is not there yet.
        </Notice>
      )
    }
    {returned === "canceled" && <Notice>No payment was taken. You can pay whenever you are ready.</Notice>}
    {payError && <Notice kind="error">{payError}</Notice>}

    {
      held && (
        <p class="text-lg text-charcoal" data-testid="hold-note">
          {booking.lead_first_name ? `Thank you, ${booking.lead_first_name}. ` : ""}
          We are holding {booking.traveler_count} {seats} for the next {minutesLeft}{" "}
          {minutesLeft === 1 ? "minute" : "minutes"}. Pay the deposit to confirm.
        </p>
      )
    }
    {
      isPending && !held && (
        <p class="text-lg text-charcoal">
          {booking.lead_first_name ? `Thank you, ${booking.lead_first_name}. ` : ""}
          You are registered, and your place is confirmed once the deposit is paid. The hold on your{" "}
          {seats} has ended, so pay while there is still room.
        </p>
      )
    }

    <dl class="divide-y divide-cream-dark border-y border-cream-dark text-sm">
      <div class="flex justify-between gap-4 py-2.5">
        <dt class="text-warm-mid">Trip</dt>
        <dd class="text-dark">{booking.trip_title}</dd>
      </div>
      <div class="flex justify-between gap-4 py-2.5">
        <dt class="text-warm-mid">Dates</dt>
        <dd class="text-dark">{formatDateRange(booking.start_date, booking.end_date)}</dd>
      </div>
      <div class="flex justify-between gap-4 py-2.5">
        <dt class="text-warm-mid">Travelers</dt>
        <dd class="text-dark">{booking.traveler_count}</dd>
      </div>
      <div class="flex justify-between gap-4 py-2.5">
        <dt class="text-warm-mid">Reference</dt>
        <dd class="font-medium text-dark" data-testid="booking-reference">{booking.reference}</dd>
      </div>
    </dl>

    <section>
      <h2 class="text-2xl">Payments</h2>
      <dl class="mt-3 divide-y divide-cream-dark border-y border-cream-dark text-sm">
        <div class="flex justify-between gap-4 py-2.5">
          <dt class="text-warm-mid">Trip total</dt>
          <dd class="text-dark">{formatUsd(booking.total_cents)}</dd>
        </div>
        {
          booking.discount_cents > 0 && (
            <div class="flex justify-between gap-4 py-2.5">
              <dt class="text-warm-mid">Credit</dt>
              <dd class="text-dark">−{formatUsd(booking.discount_cents)}</dd>
            </div>
          )
        }
        {
          booking.payments.map((payment) => (
            <div class="flex justify-between gap-4 py-2.5">
              <dt class="text-warm-mid">
                {payment.kind === "refund" ? "Refund" : "Paid"}, {formatDate(payment.received_on)}
                <span class="block text-xs">
                  {METHOD[payment.method]}
                  {payment.fee_cents > 0 && `, plus ${formatUsd(payment.fee_cents)} card fee`}
                </span>
              </dt>
              <dd class="text-dark">
                {payment.kind === "refund" ? "+" : "−"}
                {formatUsd(payment.amount_cents)}
              </dd>
            </div>
          ))
        }
        <div class="flex justify-between gap-4 py-2.5 font-medium">
          <dt class="text-dark">Balance</dt>
          <dd class="text-dark" data-testid="booking-balance">{formatUsd(balance)}</dd>
        </div>
      </dl>
      {
        balance > 0 && !isClosed && (
          <p class="mt-2 text-xs text-warm-mid">
            The full balance is due by {formatDate(booking.balance_due_date)}.
          </p>
        )
      }
    </section>

    {
      options.length > 0 && (
        <section>
          <h2 class="text-2xl">Pay by card</h2>
          <div class="mt-3 space-y-4">
            {options.map((option) => {
              const fee = cardFeeCents(option.amount_cents, feeBps);
              return (
                <form method="POST" action={postUrl} class="border border-cream-dark bg-white p-5">
                  <input type="hidden" name="reference" value={booking.reference} />
                  <input type="hidden" name="token" value={token} />
                  <input type="hidden" name="option" value={option.key} />
                  <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="text-sm">
                      <p class="font-medium text-dark">
                        {option.label}: {formatUsd(option.amount_cents)}
                      </p>
                      <p class="mt-1 text-xs text-warm-mid">
                        {fee > 0
                          ? `Plus a ${formatFeePercent(feeBps)}% card processing fee of ${formatUsd(fee)}. You will be charged ${formatUsd(option.amount_cents + fee)}.`
                          : `You will be charged ${formatUsd(option.amount_cents)}.`}
                        {option.due_date && option.key !== "balance" && ` Due ${formatDate(option.due_date)}.`}
                      </p>
                    </div>
                    <button type="submit" class="cursor-pointer bg-dark px-6 py-2.5 text-sm font-medium uppercase tracking-[0.15em] text-white transition-colors hover:bg-orange">
                      Pay {formatUsd(option.amount_cents + fee)}
                    </button>
                  </div>
                </form>
              );
            })}
          </div>
          <p class="mt-3 text-xs text-warm-mid">
            You pay on Stripe's secure page; we never see your card number.
            {feeBps > 0 && " To pay by bank transfer with no card fee, write to info@adventure-access.com with your booking reference."}
          </p>
        </section>
      )
    }

    {
      isPending && formPath && held && (
        <p class="text-sm">
          <a class="text-dark underline decoration-orange underline-offset-4" href={formPath}>
            Change traveler details
          </a>
          <span class="text-warm-mid"> You will need to enter them again. Your hold carries over.</span>
        </p>
      )
    }
    <p class="text-xs text-warm-mid">
      Keep this page's address. It is the only way back to this booking.
    </p>
  </div>
</Public>
